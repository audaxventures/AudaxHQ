# Shared passcode that gates the whole app (see src/proxy.ts + src/lib/auth.ts).
# Pick something reasonably long — it's the only thing standing between the
# public internet and your client data.
APP_PASSCODE=change-me

# Optional: a separate secret used to sign the session cookie. If omitted,
# APP_PASSCODE is reused as the secret. Set this if you want the ability to
# rotate the passcode without invalidating the signing key relationship, or
# just for extra entropy. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Postgres connection string from your Neon project (Vercel Postgres is
# Neon under the hood). Use the pooled connection string — the app talks to
# Postgres over HTTP via @neondatabase/serverless, not a raw TCP pool, so a
# single connection string is all that's needed (no separate DIRECT_URL).
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Supabase project URL and service_role secret key, used for client document
# uploads and the business logo (Storage). Create a private bucket named
# `client-documents` and a PUBLIC bucket named `business-assets` in that
# project — see README.md "Document storage setup" for the full steps. The
# service_role key has full admin access to your Supabase project, so keep
# it out of client-side code and source control; it's only ever read
# server-side (src/lib/storage.ts).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key, used to send "forgot passcode" reset emails (src/lib/email.ts).
# Sign up free at resend.com and create an API key under API Keys.
# Without this set, the "Forgot passcode?" link on the login page will fail
# to send (everything else in the app works fine without it).
RESEND_API_KEY=

# Optional: the "From" address for reset emails. Defaults to Resend's shared
# onboarding@resend.dev sender, which works immediately but looks less
# trustworthy and has lower deliverability — verify your own domain in
# Resend and use an address on it here once you're ready (e.g.
# "Verclara <noreply@yourdomain.com>").
RESEND_FROM_EMAIL=

# Optional: comma-separated list of business-owner emails allowed onto the
# platform admin portal (/admin — see src/lib/currentUser.ts's
# isPlatformAdmin). Sign in normally with that account's existing passcode;
# no separate admin credential. Leave unset and nobody has admin access.
PLATFORM_ADMIN_EMAILS=

# Optional: comma-separated hostnames that should serve the public marketing
# site (src/app/site/) instead of the app — see src/proxy.ts. Defaults to
# www.verclara.io,verclara.io if unset. Any hostname not in this list (e.g.
# localhost, or app.verclara.io) continues to serve the normal app.
MARKETING_HOSTS=

# Optional: the app's origin, used by the marketing site's "Sign in" and
# "Start for free" links (src/lib/site.ts). Set this to your app subdomain
# in production, e.g. https://app.verclara.io. Leave unset for local dev —
# it defaults to an empty string, producing same-origin links.
NEXT_PUBLIC_APP_URL=

# Stripe secret key, used for Checkout Sessions, the Billing Portal, and
# Customer creation (src/lib/stripe.ts). Use a test-mode key (sk_test_...)
# until you're ready to charge real cards. Signup and Settings > Billing
# both fail without this set.
STRIPE_SECRET_KEY=

# Signing secret for the /api/webhooks/stripe endpoint (see that route and
# the Stripe CLI/Dashboard webhook setup below) — without it, incoming
# webhook deliveries are rejected outright rather than trusted unverified.
# Get it from the Stripe Dashboard (Developers > Webhooks > your endpoint >
# Signing secret) or `stripe listen` output when testing locally.
STRIPE_WEBHOOK_SECRET=

# Shared secret the hourly Daily Brief trigger sends as "Authorization:
# Bearer <secret>" (see src/app/api/cron/daily-brief/route.ts and
# .github/workflows/daily-brief.yml). Generate with: openssl rand -hex 32.
# Without this set, the cron route rejects every request — nobody's Daily
# Brief will send, but the rest of the app is unaffected.
DAILY_BRIEF_CRON_SECRET=

# Stripe Price ids for the 3 subscription tiers x 2 billing intervals — see
# src/lib/pricing.ts for the dollar amounts these must match, and README.md
# "Stripe billing setup" for how to create the Products/Prices in the
# Stripe Dashboard. All 6 are required for signup and plan changes to work.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_ANNUAL=
